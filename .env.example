# AthleteOS environment
# Copy to .env.local. The app runs in demo mode without these keys.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI — AI Coach. Falls back to the onboarded rule engine if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Clerk — optional production auth. Demo mode is used when unset.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Supabase — optional production data layer. Local store is used when unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Needed to apply SQL migrations (schema/RLS/seed). API keys cannot run DDL.
# Use either the database connection string or a Supabase personal access token.
DATABASE_URL=
SUPABASE_ACCESS_TOKEN=
